{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Snip AI",
    "version":  "0.1.3",
    "identifier":  "com.clipper.app",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Snip AI",
                                    "width":  1200,
                                    "height":  760,
                                    "minWidth":  1000,
                                    "minHeight":  650,
                                    "backgroundColor":  "#090a0f"
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; connect-src ipc: http://ipc.localhost asset: http://asset.localhost https://tsbfuhokzkjjjkzsrcal.supabase.co https://*.supabase.co; img-src \u0027self\u0027 asset: http://asset.localhost data: blob:; media-src \u0027self\u0027 asset: http://asset.localhost blob:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; script-src \u0027self\u0027 \u0027unsafe-eval\u0027",
                                 "assetProtocol":  {
                                                       "enable":  true,
                                                       "scope":  [
                                                                     "$HOME/**"
                                                                 ]
                                                   }
                             }
            },
    "plugins":  {
                    "deep-link":  {
                                      "desktop":  {
                                                      "schemes":  [
                                                                      "snipai"
                                                                  ]
                                                  }
                                  }
                },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "resources":  {
                                     "../windows-runtime/": "windows-runtime/",
                                     "../snip-caption-renderer/src/ffmpeg-captions/engine.cjs":  "caption-renderer/engine.cjs"
                                 },
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               }
}
